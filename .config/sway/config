set $mod Mod4
set $mod1 Mod1
set $mod2 Control

default_border pixel
default_border none
gaps inner 0
gaps outer 0

focus_follows_mouse yes
floating_modifier $mod normal

input * {
    repeat_delay 140
    repeat_rate 75
    xkb_options caps:swapescape
}

# app keybinds and shortcuts
bindsym $mod+Return exec $TERMINAL
bindsym $mod+backslash exec wmenu-run
bindsym Print exec print_screen
bindsym Scroll_Lock exec toggle_mic
bindsym $mod+p exec swaymsg input "*" xkb_layout us
bindsym $mod+Shift+p exec swaymsg input "*" xkb_layout "cz(qwerty)"

# mpd
bindsym $mod1+Up exec mpc volume +5
bindsym $mod1+Down exec mpc volume -5
bindsym $mod1+Left exec mpc prev
bindsym $mod1+Right exec mpc next
bindsym $mod+Left exec mpc toggle
bindsym $mod+Right exec mpc stop

# system sound
bindsym $mod+Up exec wpctl set-volume --limit 1.0 '@DEFAULT_AUDIO_SINK@' '1%+'
bindsym $mod+Down exec wpctl set-volume --limit 1.0 '@DEFAULT_AUDIO_SINK@' '1%-'

# brightness
bindsym XF86MonBrightnessUp exec brightnessctl set '10%+'
bindsym XF86MonBrightnessDown exec brightnessctl set '10%-'

# close and kill
bindsym $mod+q kill
bindsym $mod+Shift+q exec ~/documents/code/scripts/kill_focused

# focus in direction
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused in direction
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# layout modes
bindsym $mod+n splitv
bindsym $mod+m splith
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen

# Resize
bindsym $mod+Control+h resize grow width 20px
bindsym $mod+Control+j resize shrink height 20px
bindsym $mod+Control+k resize grow height 20px
bindsym $mod+Control+l resize shrink width 20px

include ~/.config/sway/startup
include ~/.config/sway/workspaces
